rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAccount() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.phone_number != null ||
        (request.auth.token.firebase != null && (
          request.auth.token.firebase.sign_in_provider == 'google.com' ||
          request.auth.token.firebase.sign_in_provider == 'password' ||
          request.auth.token.firebase.sign_in_provider == 'phone'
        ))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProvider(p) {
      return p in ['google', 'email', 'phone'];
    }

    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'provider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'provider', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.provider is string
        && isValidProvider(data.provider)
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phoneNumber', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && data.updatedAt is timestamp;
    }

    function isValidWellnessSyncDoc(data, userId, docId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'schemaVersion', 'xp', 'level', 'streakDays',
          'encryptedCiphertextHex', 'encryptedIvHex', 'encryptedAlgorithm',
          'keyFingerprint', 'encryptedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'schemaVersion', 'xp', 'level', 'streakDays',
          'encryptedCiphertextHex', 'encryptedIvHex', 'encryptedAlgorithm',
          'keyFingerprint', 'encryptedAt', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == docId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.schemaVersion is number
        && data.schemaVersion >= 1
        && data.xp is number
        && data.xp >= 0
        && data.level is number
        && data.level >= 1
        && data.streakDays is number
        && data.streakDays >= 0
        && data.encryptedCiphertextHex is string
        && data.encryptedCiphertextHex.size() >= 1
        && data.encryptedCiphertextHex.size() <= 240000
        && data.encryptedIvHex is string
        && data.encryptedIvHex.size() >= 1
        && data.encryptedIvHex.size() <= 64
        && data.encryptedAlgorithm is string
        && data.encryptedAlgorithm.size() >= 1
        && data.encryptedAlgorithm.size() <= 64
        && data.keyFingerprint is string
        && data.keyFingerprint.size() >= 1
        && data.keyFingerprint.size() <= 64
        && data.encryptedAt is string
        && data.encryptedAt.size() >= 4
        && data.encryptedAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEncryptedJournalDoc(data, userId, entryId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'moodScore', 'moodLabel',
          'encryptedCiphertextHex', 'encryptedIvHex', 'encryptedAlgorithm',
          'keyFingerprint', 'encryptedAt', 'clientCreatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'moodScore', 'moodLabel',
          'encryptedCiphertextHex', 'encryptedIvHex', 'encryptedAlgorithm',
          'keyFingerprint', 'encryptedAt', 'clientCreatedAt', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == entryId
        && isValidId(data.id)
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.moodScore is number
        && data.moodScore >= 1
        && data.moodScore <= 5
        && data.moodLabel is string
        && data.moodLabel.size() >= 1
        && data.moodLabel.size() <= 64
        && data.encryptedCiphertextHex is string
        && data.encryptedCiphertextHex.size() >= 1
        && data.encryptedCiphertextHex.size() <= 60000
        && data.encryptedIvHex is string
        && data.encryptedIvHex.size() >= 1
        && data.encryptedIvHex.size() <= 64
        && data.encryptedAlgorithm is string
        && data.encryptedAlgorithm.size() >= 1
        && data.encryptedAlgorithm.size() <= 64
        && data.keyFingerprint is string
        && data.keyFingerprint.size() >= 1
        && data.keyFingerprint.size() <= 64
        && data.encryptedAt is string
        && data.encryptedAt.size() >= 4
        && data.encryptedAt.size() <= 64
        && data.clientCreatedAt is string
        && data.clientCreatedAt.size() >= 4
        && data.clientCreatedAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedAccount()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedAccount()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'provider', 'photoUrl', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if false;
        allow create: if isVerifiedAccount()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedAccount()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phoneNumber', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      match /wellnessSync/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId)
          && isValidId(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedAccount()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidWellnessSyncDoc(incoming(), userId, docId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedAccount()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidWellnessSyncDoc(incoming(), userId, docId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'schemaVersion', 'xp', 'level', 'streakDays',
            'encryptedCiphertextHex', 'encryptedIvHex', 'encryptedAlgorithm',
            'keyFingerprint', 'encryptedAt', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      match /encryptedJournals/{entryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
        allow list: if isOwner(userId)
          && isValidId(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedAccount()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && isValidEncryptedJournalDoc(incoming(), userId, entryId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedAccount()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && isValidEncryptedJournalDoc(incoming(), userId, entryId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'moodScore', 'moodLabel', 'encryptedCiphertextHex', 'encryptedIvHex',
            'encryptedAlgorithm', 'keyFingerprint', 'encryptedAt', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      }
    }
  }
}
